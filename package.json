{
  "name": "barnsdall-art-park-foundation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "studio",
    "web"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -n web,studio -c green,magenta \"npm run dev -w web\" \"npm run dev -w studio\"",
    "dev:web": "npm run dev -w web",
    "dev:studio": "npm run dev -w studio",
    "build": "npm run typegen && npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "typegen": "npm run typegen -w studio",
    "schema:deploy": "npm run schema:deploy -w studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "undici": "^7.30.1",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    }
  }
}
